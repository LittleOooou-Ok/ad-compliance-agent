# DeepSeek API Configuration (for LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DashScope API Configuration (for Embedding)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024

# MiMo-V2.5 API Configuration (for Multimodal Understanding)
MIMO_API_KEY=sk-your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Vector Database
CHROMA_PERSIST_DIR=D:\AdvertingReview\data\chroma_db
CHROMA_COLLECTION_NAME=ad_rules

# Database
DATABASE_URL=sqlite+aiosqlite:///D:\AdvertingReview\data\ad_review.db

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Evaluation
EVAL_TEST_SET_PATH=D:\AdvertingReview\data\test_set\test_cases.json

# MCP (optional - external MCP servers)
# MCP_SERVER_URLS=http://localhost:3001,http://localhost:3002
